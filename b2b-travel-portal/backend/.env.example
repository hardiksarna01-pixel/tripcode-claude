# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Flight API Configuration
FLIGHT_API_BASE_URL=http://your-domain/airlinehost/AirAPIService.svc/JSONService
TRADE_API_BASE_URL=http://your-domain/tradehost/TradeAPIService.svc/JSONService

# CORS
CORS_ORIGIN=http://localhost:3000

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/b2b_travel

# Logging
LOG_LEVEL=debug

# AI Features (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key
