# ==============================================
# B2B/B2C TRAVEL PORTAL - Environment Variables
# ==============================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_portal
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ADMIN_JWT_SECRET=your-admin-secret-key-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-32-character-secret-key-here

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM_NAME=Travel Portal
EMAIL_FROM_ADDRESS=noreply@travelportal.com

# SMS Configuration
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=TRAVEL

# WhatsApp Configuration
WHATSAPP_PROVIDER=wati
WATI_API_URL=https://api.wati.io
WATI_API_KEY=your-wati-api-key

# Payment Gateways
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_MERCHANT_SALT=your-payu-merchant-salt
PAYU_TEST_MODE=true

STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# AI Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet

# Flight API Suppliers
AMADEUS_API_URL=https://api.amadeus.com
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

TBO_API_URL=https://api.tbo.com
TBO_USER_ID=your-tbo-user-id
TBO_PASSWORD=your-tbo-password

TRIPJACK_API_URL=https://api.tripjack.com
TRIPJACK_API_KEY=your-tripjack-api-key

# Hotel API Suppliers
HOTELBEDS_API_URL=https://api.hotelbeds.com
HOTELBEDS_API_KEY=your-hotelbeds-api-key
HOTELBEDS_SECRET=your-hotelbeds-secret

TBO_HOTEL_API_URL=https://api.tbo.com/hotel
TBO_HOTEL_USER_ID=your-tbo-hotel-user-id
TBO_HOTEL_PASSWORD=your-tbo-hotel-password

# Bus API Suppliers
REDBUS_API_URL=https://api.redbus.in
REDBUS_API_KEY=your-redbus-api-key

ABHIBUS_API_URL=https://api.abhibus.com
ABHIBUS_API_KEY=your-abhibus-api-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
